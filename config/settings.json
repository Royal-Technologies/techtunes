{
  "archive_name": "Techtunes Archive | টেকটিউনস আর্কাইভ",
  "archive_tagline": "মেতে উঠুন প্রযুক্তির সুরে — Techtunes Daily Mirror & Digital Preservation Platform",
  "default_author": "Techtunes Community",
  "base_website_url": "https://royal-technologies.github.io/techtunes",
  "github_repo_url": "https://github.com/Royal-Technologies/techtunes",
  "sync": {
    "overlap_hours": 48,
    "request_timeout_seconds": 30,
    "max_retries": 3,
    "retry_backoff_factor": 1.5,
    "batch_size": 50,
    "delay_between_requests_ms": 150,
    "fetch_workers": 6,
    "incremental_max_pages": 5,
    "full_max_pages": 0,
    "include_homepage": true,
    "include_sitemap_recent": 5000
  },
  "database": {
    "path": "database/archive.sqlite",
    "schema_path": "database/schema.sql",
    "migrations_dir": "database/migrations",
    "wal_mode": true,
    "compact_sqlite": true
  },
  "exports": {
    "directory": "exports",
    "pretty_json": true
  },
  "articles": {
    "base_directory": "articles"
  },
  "media": {
    "base_directory": "media"
  }
}
