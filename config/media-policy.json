{
  "enabled": true,
  "max_file_size_bytes": 10485760,
  "convert_to_webp": true,
  "webp_quality": 72,
  "max_width": 640,
  "allowed_mime_types": [
    "image/jpeg",
    "image/png",
    "image/webp",
    "image/gif",
    "image/svg+xml"
  ],
  "allowed_extensions": [
    ".jpg",
    ".jpeg",
    ".png",
    ".webp",
    ".gif",
    ".svg"
  ],
  "download_featured_images": true,
  "download_embedded_images": false,
  "allowed_domains": [
    "techtunes.io",
    "www.techtunes.io",
    "dnc.techtunes.io",
    "secure.gravatar.com",
    "gravatar.com"
  ],
  "disallow_private_ips": true,
  "request_timeout_seconds": 25,
  "max_retries": 3
}
